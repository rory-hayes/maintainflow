{
  "name": "maintainflow-ads",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ads-contract": "vitest run --config vitest.contract.config.mjs",
    "test:ads-simulator": "vitest run src/lib/openai-ads/provider-simulator.test.ts",
    "test:ads-live": "vitest run --config vitest.live.config.mjs",
    "check:openai-ads-contract": "node scripts/check-openai-ads-openapi.mjs",
    "test:openai-ads-contract-checker": "vitest run scripts/check-openai-ads-openapi.test.mjs",
    "test:production-config": "vitest run scripts/check-production-config.test.mjs",
    "db:migrate": "node scripts/run-database-migrations.mjs",
    "test:db-migrations": "vitest run scripts/run-database-migrations.test.mjs",
    "test:db": "node scripts/run-database-integration.mjs",
    "check:production-config": "node scripts/check-production-config.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:ads-contract && npm run test:openai-ads-contract-checker && npm run test:production-config && npm run build"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.3",
