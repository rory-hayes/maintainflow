# Issued from the Settings tab in OpenAI Ads Manager. This is not a Platform API key.
OPENAI_ADS_API_KEY=

# Keep demo until the account-scoped Ads key is available and read sync is tested.
MAINTAINFLOW_RELEASE_STAGE=demo
OPENAI_ADS_DATA_MODE=demo

# A key and live reads alone can never enable external writes.
OPENAI_ADS_LIVE_WRITES_ENABLED=false

# Exact public HTTPS origin used for production mutation/CSRF checks.
MAINTAINFLOW_APP_ORIGIN=https://maintainflow.io
# Enable only behind a reverse proxy that overwrites X-Forwarded-Proto.
MAINTAINFLOW_TRUST_PROXY_HEADERS=false

# Required for every production deployment, including the public demo, so
# customer-facing privacy and support routes identify a monitored operator.
MAINTAINFLOW_LEGAL_ENTITY_NAME=
MAINTAINFLOW_PRIVACY_CONTACT_EMAIL=
MAINTAINFLOW_SUPPORT_CONTACT_EMAIL=

# Global kill switch for every real Conversions API dry run, including
# per-account credentials stored in the encrypted PostgreSQL vault.
OPENAI_CONVERSIONS_VALIDATE_ONLY_ENABLED=false

# Optional server-managed fallback for one pilot account. Customer Pixel/CAPI
# pairs use the protected connection route and migration 010 instead. This key
# is separate from OPENAI_ADS_API_KEY and must never enter public configuration.
OPENAI_CONVERSIONS_ACCOUNT_ID=
OPENAI_CONVERSIONS_PIXEL_ID=
OPENAI_CONVERSIONS_API_KEY=

# Required before live account data or mutations can be exposed to an operator.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
# Keep private_beta until paid entitlements, support, and offboarding are ready.
# Only the listed Clerk user IDs can create a first live workspace in this mode.
MAINTAINFLOW_ADMISSION_MODE=private_beta
MAINTAINFLOW_PRIVATE_BETA_OPERATOR_IDS=
# This remains false for private beta. Public sign-up also requires admission
# mode `open`, so either missing gate keeps account creation closed.
MAINTAINFLOW_PUBLIC_SIGN_UP_ENABLED=false
# Narrow bootstrap list used only to claim a newly connected, unowned Ads account.
# Ongoing read/write access comes from the database tenancy roles.
MAINTAINFLOW_BOOTSTRAP_OPERATOR_IDS=

# PostgreSQL connection used for customer tenancy, approval evidence, rollback
# payloads, creative transitions, durable monitoring windows, and outcomes.
# Every production release, including demo, requires exactly one
# sslmode=verify-full parameter because public readiness quotas use PostgreSQL.
DATABASE_URL=
# Shared postgres.js pool cap per running application instance. Horizontally
# scaled and serverless instances each receive their own pool.
MAINTAINFLOW_DATABASE_POOL_MAX=4

# Required for self-service client account connections. Generate a 32-byte key
# with `openssl rand -base64 32`, store it only as a server secret, and keep old
# key IDs in the JSON keyring until every credential has been rotated.
MAINTAINFLOW_CREDENTIAL_KEYRING={"v1":"base64-encoded-32-byte-key"}
MAINTAINFLOW_ACTIVE_CREDENTIAL_KEY_ID=v1

# Required in every production stage for the scheduled monitoring and retention
# endpoint. Use at least 32 random characters; Vercel Cron sends it as
# Authorization: Bearer.
CRON_SECRET=

# Required in every production stage for the shared public-audit quota. Use an
# independent 32+ character secret to HMAC client/target identifiers before
# PostgreSQL storage.
READINESS_RATE_LIMIT_SECRET=
# Leave false on Vercel. Enable only when a trusted custom reverse proxy
# overwrites X-Forwarded-For rather than accepting a client-supplied value.
READINESS_TRUST_X_FORWARDED_FOR=false
