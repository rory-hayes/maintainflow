# Copy only the settings you need into ignored, server-only .env.local.
# Empty provider credentials keep the integration blocked.

# Local billing simulation is explicitly opt-in and disabled in production.
FOLIO_BILLING_MOCK=false

# Password recovery and verification use a separate, disabled-by-default sender.
# Use a verified sender/domain and a dedicated server-only Resend sending key.
# Do not reuse the receiving key below. Configure trusted APP_ORIGIN as well;
# production/remote links require HTTPS. Configuration is not delivery proof.
FOLIO_AUTH_EMAIL_ENABLED=false
FOLIO_AUTH_EMAIL_FROM=
FOLIO_AUTH_EMAIL_API_KEY=

# Optional read-only diagnostics credential for an independent monitor.
# This key cannot wake workers; never use the worker secret in public CI.
FOLIO_MONITOR_SECRET=

# New-account verification defaults to true in production, false in local/test.
# Optional override accepts only true or false; leave the line absent for defaults.
# A development/private-preview bypass never marks an email as verified. Existing
# accounts retain access, and pending required accounts stay locked if disabled.
# FOLIO_REQUIRE_EMAIL_VERIFICATION=true

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_ENABLED=false

# Default: a custom domain with enabled receiving and a verified Receiving MX.
RESEND_RECEIVING_MODE=custom
RESEND_INBOUND_DOMAIN=
RESEND_DOMAIN_ID=

# Alternative: set RESEND_RECEIVING_MODE=managed and configure the team's
# exact single-label <id>.resend.app domain. No custom RESEND_DOMAIN_ID is used.
# First send a dedicated plain-text email to a fresh random probe recipient:
#   folio-probe-<32 lowercase random hex characters>@<id>.resend.app
# Set both its subject and body to: Folio receiving probe <nonce>
# The nonce must be 32-64 lowercase random hex characters. Do not add a signature.
# RESEND_MANAGED_PROBE_EMAIL_ID is the UUID of the RECEIVED email, not a sent ID.
# This proves probe retrieval only; signed webhook and parser intake need a
# separate delivered test email and a publicly reachable HTTPS webhook endpoint.
RESEND_MANAGED_PROBE_EMAIL_ID=
RESEND_MANAGED_PROBE_RECIPIENT=
RESEND_MANAGED_PROBE_NONCE=

# Public operator disclosures: populate only with verified, approved information.
# Existing MAINTAINFLOW_LEGAL_ENTITY_NAME, MAINTAINFLOW_SUPPORT_CONTACT_EMAIL and
# MAINTAINFLOW_PRIVACY_CONTACT_EMAIL remain supported fallbacks for those fields.
# HTTPS policy URLs point to the operator's completed documents. Configuration
# does not activate public registration, payments or certify legal review.
FOLIO_OPERATOR_NAME=
FOLIO_SUPPORT_EMAIL=
FOLIO_PRIVACY_EMAIL=
FOLIO_PRIVACY_URL=
FOLIO_TERMS_URL=
FOLIO_SUBPROCESSORS_URL=
FOLIO_RETENTION_NOTICE=
FOLIO_DATA_LOCATION_NOTICE=
