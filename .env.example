# MaintainCode Ads production target: existing user-owned domain, new Supabase project.
MAINTAINCODE_APP_ORIGIN=https://maintainflow.io

# Public browser values: set at BUILD TIME and runtime, using the same project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never put a Supabase secret/service-role key in either NEXT_PUBLIC value.
# Supabase authentication owns self-service identity; these retain consistent UI admission.
MAINTAINFLOW_ADMISSION_MODE=open
MAINTAINFLOW_PUBLIC_SIGN_UP_ENABLED=true

# Server-only PostgreSQL runtime. Migration 024 creates this restricted role.
# Use maintaincode_app.PROJECT_REFERENCE on a pooler where project qualification is required.
DATABASE_URL=
# Exactly one sslmode=verify-full parameter is required in DATABASE_URL.
MAINTAINFLOW_DATABASE_CA_CERT=
MAINTAINFLOW_DATABASE_POOL_MAX=4

# Server-only encryption; generate a unique 32-byte key and retain old IDs until rotation.
MAINTAINFLOW_CREDENTIAL_KEYRING={"v1":"base64-encoded-32-byte-key"}
MAINTAINFLOW_ACTIVE_CREDENTIAL_KEY_ID=v1
# Independent secrets of at least 32 characters. Never expose them to website scripts.
MAINTAINFLOW_READINESS_PROBE_SECRET=
MAINTAINCODE_MAINTENANCE_SECRET=
# Vercel Cron authenticates daily GET maintenance with this separate secret.
CRON_SECRET=
# Optional opted-in workspace reports; server-only and disabled by default.
MAINTAINCODE_REPORT_EMAILS_ENABLED=false
MAINTAINCODE_REPORT_FROM=
RESEND_API_KEY=

# Identify the actual operating person/entity and monitored contacts in legal pages.
MAINTAINFLOW_LEGAL_ENTITY_NAME=
MAINTAINFLOW_PRIVACY_CONTACT_EMAIL=
MAINTAINFLOW_SUPPORT_CONTACT_EMAIL=

# Ads cost sync: these flags permit read-only requests with each workspace's vaulted key.
# Keep demo until account access is configured and being verified.
MAINTAINFLOW_RELEASE_STAGE=demo
OPENAI_ADS_DATA_MODE=demo
OPENAI_ADS_LIVE_WRITES_ENABLED=false
OPENAI_CONVERSIONS_VALIDATE_ONLY_ENABLED=false

# Billing: use Stripe TEST credentials and actual matching EUR prices for acceptance.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_AGENCY_MONTH=
STRIPE_PRICE_AGENCY_YEAR=

# Full commit SHA at BUILD TIME, never an invented runtime override.
# Vercel supplies VERCEL_GIT_COMMIT_SHA; Docker accepts MAINTAINFLOW_BUILD_SHA.
MAINTAINFLOW_BUILD_SHA=
# Set only for an explicitly disposable LOOPBACK DEVELOPMENT database; unset when deployed.
MAINTAINCODE_LOCAL_TEST=

# Hosted revision verification; probe secret is already configured above.
MAINTAINCODE_PROBE_ORIGIN=https://maintainflow.io
MAINTAINCODE_EXPECTED_BUILD_SHA=
