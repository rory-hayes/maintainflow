# Copy this to an ignored/private file such as .local/deploy.env; chmod 600 it.
# Do not commit real values or print `docker compose config` with them.
APP_ORIGIN=https://maintainflow.io
MAINTAINFLOW_HTTP_PORT=4318
MAINTAINFLOW_IMAGE_TAG=local
MAINTAINFLOW_BUILD_SHA=unrecorded

# Generate distinct passwords as 32 random bytes encoded as hex (64 characters).
# The Compose URLs require URL-safe letters/digits/underscore/hyphen only.
FOLIO_DB_ADMIN_PASSWORD=
FOLIO_DB_APP_PASSWORD=
# Generate 32 random bytes encoded as base64. Preserve this key with backups and
# supply the exact same value to API and worker on every deployment.
INTEGRATION_ENCRYPTION_KEY=

# Empty provider settings keep integrations unavailable. This file is not proof
# of provider setup. Billing mock is always disabled by compose.yaml.
OPENAI_API_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_ENABLED=false
RESEND_RECEIVING_MODE=custom
RESEND_INBOUND_DOMAIN=
RESEND_DOMAIN_ID=
RESEND_MANAGED_PROBE_EMAIL_ID=
RESEND_MANAGED_PROBE_RECIPIENT=
RESEND_MANAGED_PROBE_NONCE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://maintainflow.io/api/google/callback
# Only test credentials are supported by the current billing adapter.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_TEAM=
